# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local al repositorio.
# Local: valores impresos por `node scripts/stack/keys.mjs` (pila local sin Docker).

# URL pública del sitio (enlaces de email, metadatos)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). La anon/publishable key es pública por diseño; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Salta RLS: usar únicamente en código server-only y nunca exponerla al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Pruebas E2E/DB locales
LOCAL_DB_URL=postgres://postgres@127.0.0.1:54322/academia
MAILPIT_URL=http://127.0.0.1:54324

# Futuro (Hito 5/6) — dejar vacío hasta autorización explícita
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ANTHROPIC_API_KEY=

# Solo local/E2E: eleva el límite de intentos de auth (no definir en producción)
# AUTH_RATE_LIMIT_MAX=1000
